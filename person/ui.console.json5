{
  menu: {
    people: {
      title: 'People',
      icon: 'people',
      type: 'collapse',
      children: {
        'person-list': {
          title: 'Everybody',
          icon: 'person',
          url: '/person'
        }
      }
    }
  },
  routes: {
    person: {
      layout: 'full_width',
      components: {
        header: ['Everybody'],
        main: [
          {
            component: 'RecordList',
            properties: {
              table: 'person',
              includes: {
                names: {
                  table: 'person_name'
                },
                emails: {
                  table: 'person_email'
                }
              },
              columns: [
                {
                  title: 'Id',
                  dataIndex: 'id',
                  sorter: true,
                  width: '20%'
                },
                {
                  title: 'Name',
                  dataIndex: 'name',
                  template: '{{names.0.given_name}} {{names.0.family_name}} {{emails.0.email}}',
                  width: '40%'
                },
                {
                  title: 'Email',
                  template: '{{emails.0.email}}',
                  width: '40%'
                }
              ],
              onRow: {
                onClick: {
                  action: 'navigate',
                  url: '/person/{{record.id}}'
                }
              }
            }
          }
        ]
      }
    },
    'person/:id/*': {
      layout: 'sidebar',
      components: {
        sidebar: {
          title: 'Person Details',
          items: [
            {
              component: 'RecordDisplay',
              properties: {
                table: 'person',
                id: '{{parameters.id}}',
                includes: {
                  names: {
                    table: 'person_name'
                  },
                  emails: {
                    table: 'person_email',
                    orderBy: 'preference_order'
                  }
                },
                template: '{{names.0.given_name}} {{names.0.family_name}} {{#if emails.0.email}}<{{emails.0.email}}>{{/if}}'
              }
            }
          ]
        },
        main: [
          {
            // 'path':'overview', //no path is the default
            component: 'RecordDisplay',
            properties: {
              table: 'person',
              id: '{{parameters.id}}',
              includes: {
                names: {
                  table: 'person_name'
                }
              },
              template: '{{names.0.given_name}} {{names.0.family_name}}'
            }
          }
        ]
      }
    }
  }
}
